# App
NEXT_PUBLIC_APP_NAME="MartFlow"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be set on Vercel too, at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Firebase client (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="mart-flow.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="mart-flow"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin (server only — never prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID="mart-flow"
FIREBASE_CLIENT_EMAIL=""
# Easiest on Windows: quoted path to the downloaded service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH="C:/keys/your-project-firebase-adminsdk.json"
# Or paste only the private_key value on one quoted line, keeping \n sequences:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""
